PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,https://loja.soio.com.br

# GestãoClick
GESTAOCLICK_ACCESS_TOKEN=
GESTAOCLICK_SECRET_ACCESS_TOKEN=
GESTAOCLICK_API_URL=https://api.gestaoclick.com

# Safe2Pay — Administração > Configurações > Integração
# Key → header X-API-KEY | Token → credencial complementar (não expor no frontend)
SAFE2PAY_API_KEY=
SAFE2PAY_TOKEN=
SAFE2PAY_SANDBOX=true
SAFE2PAY_API_URL=https://payment.safe2pay.com.br

# Database (Semana 1+)
# DATABASE_URL=postgresql://soio:soio@localhost:5432/soio_loja

# Redis (fila integração)
# REDIS_URL=redis://localhost:6379
